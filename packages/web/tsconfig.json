{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/app/*": ["./src/app/*"],
      "@/*": ["../core/*"],
      "@airoute/core": ["../core"],
      "@airoute/core/*": ["../core/*"],
      "@omniroute/open-sse": ["../open-sse/index.ts"],
      "@omniroute/open-sse/*": ["../open-sse/*"],
      "@airoute/open-sse": ["../open-sse/index.ts"],
      "@airoute/open-sse/*": ["../open-sse/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
