{
  "name": "airoute",
  "private": true,
  "version": "1.1.2",
  "description": "Local-first OpenAI-compatible AI router",
  "license": "MIT",
  "homepage": "https://github.com/foisalislambd/airoute#readme",
  "bugs": {
    "url": "https://github.com/foisalislambd/airoute/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foisalislambd/airoute.git"
  },
  "workspaces": [
    "apps/panel",
    "packages/sse"
  ],
  "scripts": {
    "dev:panel": "npm run dev -w @airoute/panel",
    "build:panel": "npm run build -w @airoute/panel",
    "dev:server": "go run ./apps/server/cmd/airoute",
    "dev:desktop": "go run ./apps/desktop/cmd/airoute-desktop",
    "build:npm": "node scripts/build_npm.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
