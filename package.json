{
  "name": "airoute",
  "version": "0.1.0",
  "private": true,
  "description": "AIRoute — local AI gateway (web + streaming engine + core)",
  "license": "MIT",
  "author": "foisalislambd",
  "homepage": "https://github.com/foisalislambd/airoute#readme",
  "repository": {
    "type": "git",
